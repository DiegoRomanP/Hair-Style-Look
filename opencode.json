{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "mcp": {
    "headroom": {
      "enabled": false
    },
    "serena": {
      "enabled": false
    },
    "open-design": {
      "enabled": false
    },
    "engram": {
      "type": "local",
      "command": [
        "engram",
        "mcp",
        "--tools=agent",
        "--project",
        "Hair-Style-Look"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": "ask",
    "task": "deny",
    "skill": {
      "*": "ask",
      "hair-*": "allow",
      "vercel-react-best-practices": "allow",
      "playwright-skill": "allow"
    },
    "question": "allow",
    "mcp_*": "ask",
    "external_directory": "ask"
  }
}
