# Application
NEXT_PUBLIC_APP_URL=
LOG_LEVEL=info
SESSION_COOKIE_NAME=hsl_session
SESSION_COOKIE_MAX_AGE_SECONDS=604800
SESSION_TOKEN_PEPPER=

# Local MongoDB (implemented in Phase 1)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=hair_style_look

# Image generation (implemented in Phase 3)
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Local jobs and cost controls
GENERATION_JOB_TIMEOUT_MS=120000
GENERATION_JOB_LEASE_MS=180000
MAX_CONCURRENT_GENERATIONS_PER_SESSION=2
MAX_EQUIVALENT_REQUESTS_BEFORE_WARNING=5
MAX_OPENAI_BUDGET_CENTS=1000

# Asset limits
MODERATION_ASSET_RETENTION_HOURS=24
MAX_UPLOAD_BYTES=5242880
MAX_CUSTOM_STYLE_LENGTH=120
